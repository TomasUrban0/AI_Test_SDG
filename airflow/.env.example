# Variables de entorno para docker-compose
# Copiar este archivo como .env antes de ejecutar:
#   cp .env.example .env
#
# AIRFLOW_UID: debe coincidir con tu usuario de Linux/macOS.
# En Linux: ejecuta "id -u" para obtenerlo.
# En macOS/Windows (WSL2): generalmente 50000 funciona.
AIRFLOW_UID=50000
